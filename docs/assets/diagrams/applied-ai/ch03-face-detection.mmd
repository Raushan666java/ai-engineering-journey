flowchart TD
    Capture["Image / Video Frame"] --> Preprocess["Convert to Grayscale"]
    Preprocess --> Cascade["Haar Cascade\nClassifier"]
    Cascade --> Scale["Scale Factor: 1.1\nMin Neighbors: 5"]
    Scale --> DetectFaces{"Faces\nDetected?"}
    DetectFaces -->|Yes| Draw["Draw Green\nBounding Boxes"]
    DetectFaces -->|No| Skip["Skip Frame"]
    Draw --> Output["Output Image\nwith Annotations"]
    Skip --> Next["Next Frame"]
    Output --> Next

    Capture --> DNN["DNN-based Detector\n(SSD / YOLO)"]
    DNN --> Blob["Create Blob\n(resize + normalize)"]
    Blob --> Forward["Forward Pass\nthrough Network"]
    Forward --> FilterConf{"Confidence\n> 0.7?"}
    FilterConf -->|Yes| DrawDNN["Draw Box +\nConfidence Score"]
    FilterConf -->|No| SkipDNN["Skip Detection"]
    DrawDNN --> Output
    SkipDNN --> Next

    style Capture fill:#fff3e0,stroke:#f57c00,color:#000,stroke-width:2px
    style Cascade fill:#e3f2fd,stroke:#1565c0,color:#000
    style DNN fill:#e8f5e9,stroke:#2e7d32,color:#000
    style Output fill:#fce4ec,stroke:#c62828,color:#000
