# ---------------------------------------------------------------------------
# Copy to automation/.env  (never commit it — .env is already gitignored)
# ---------------------------------------------------------------------------

# --- Publishing (required only when you run `npm run publish -- --real`) ----
# Instagram Graph API, Business or Creator account linked to a Facebook Page.
# Get these from https://developers.facebook.com → your app → Graph API Explorer
#   IG_USER_ID      = the Instagram *business* account id (not the @handle)
#   IG_ACCESS_TOKEN = long-lived token with instagram_content_publish
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Media hosting (one of the two, required for publishing) ----------------
# Option A: Supabase Storage (free tier is enough)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=social

# Option B: you already host automation/out/ somewhere public
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/social

# --- Safety switch ---------------------------------------------------------
# Leave empty for dry runs. `npm run publish -- --real` overrides this anyway.
# PUBLISH=1
