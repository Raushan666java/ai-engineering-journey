flowchart TD
    subgraph KBAgent["Knowledge-Based Agent"]
        KB["Knowledge Base\nSentences in formal language"]
        Tell["TELL: Add facts to KB"]
        Ask["ASK: Query KB for inference"]
        Action["Act on inferred knowledge"]
    end

    subgraph PropLogic["Propositional Logic"]
        PL1["Syntax: P, Q, ¬, ∧, ∨, →, ↔"]
        PL2["Semantics: Truth tables"]
        PL3["Inference: Modus Ponens\nResolution, Forward/Backward"]
        PL4["Entailment: KB |= α"]
    end

    subgraph FOL["First-Order Logic"]
        FOL1["Syntax: Constants, Predicates\nFunctions, Variables, Quantifiers"]
        FOL2["∀ (Universal) · ∃ (Existential)"]
        FOL3["Unification: Find substitution θ\nmaking literals identical"]
        FOL4["Inference: Generalized Modus Ponens\nForward Chaining, Backward Chaining"]
    end

    subgraph Resolution["Resolution Algorithm"]
        R1["Convert to CNF"]
        R2["Negate query"]
        R3["Resolve complementary literals"]
        R4["Empty clause → proof found"]
    end

    style KBAgent fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style PropLogic fill:#fff3e0,stroke:#f57c00,color:#000
    style FOL fill:#e8f5e9,stroke:#2e7d32,color:#000
    style Resolution fill:#fce4ec,stroke:#c62828,color:#000
