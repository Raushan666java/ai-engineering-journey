flowchart TD
    DB["Cloud Database\nServices"] --> SQL["Relational SQL\nACID compliance\nStructured data, Joins"]
    DB --> NoSQL["NoSQL\nHorizontal scale\nUnstructured data"]
    DB --> Cache["In-Memory Cache\nMicrosecond latency\nFrequent reads"]

    SQL --> RDS["Managed RDS\nMySQL, PostgreSQL\nSQL Server, Oracle"]
    SQL --> Native["Cloud-Native\nAurora, Spanner\nCompute/storage decoupled"]
    SQL --> DW["Data Warehouse\nRedshift, Synapse\nBigQuery"]

    NoSQL --> KV["Key-Value\nDynamoDB, Cosmos DB"]
    NoSQL --> Doc["Document\nFirestore, Cosmos"]
    NoSQL --> WC["Wide-Column\nBigtable, Keyspaces"]

    Cache --> Redis["Redis\nElastiCache\nMemorystore"]
    Cache --> Memc["Memcached\nElastiCache"]

    SQL --> HA["High Availability\nMulti-AZ sync\nAuto failover"]
    SQL --> RR["Read Replicas\nAsync replication\nRead scaling"]

    style DB fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style SQL fill:#e8f5e9,stroke:#2e7d32,color:#000
    style NoSQL fill:#fff3e0,stroke:#f57c00,color:#000
    style Cache fill:#f3e5f5,stroke:#7b1fa2,color:#000
