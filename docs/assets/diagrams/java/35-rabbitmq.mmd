flowchart TB
  RMQ[RabbitMQ / AMQP]
  RMQ --> AMQP[AMQP Model]
  AMQP --> EX[Exchange Types]
  EX --> DIR[Direct]
  EX --> TOP[Topic]
  EX --> FAN[Fanout]
  EX --> HDR[Headers]
  AMQP --> QUEUE[Queue Types]
  QUEUE --> DUR[Durable]
  QUEUE --> EXC[Exclusive]
  QUEUE --> AD[Auto-Delete]
  QUEUE --> TTL[TTL Queues]
  QUEUE --> DLX[Dead-Letter Exchange]
  QUEUE --> MAX[Max Length]
  AMQP --> BIND[Bindings]
  BIND --> RK[Routing Keys]
  BIND --> ARG[Arguments]

  RMQ --> SPRING[Spring AMQP]
  SPRING --> SEND[RabbitTemplate]
  SEND --> CONV[Message Converter]
  CONV --> JSON[Jackson2Json]
  SEND --> CONF[Publisher Confirms]
  SEND --> RET[Returns]
  SPRING --> RECV[RabbitListener]
  RECV --> CONC[Concurrency]
  RECV --> MAN[Manual Ack]
  SPRING --> BATCH[BatchingRabbitTemplate]

  RMQ --> REL[Reliability]
  REL --> RETRY[RetryTemplate]
  RETRY --> BACK[Exponential Backoff]
  RETRY --> REC[Message Recoverer]
  REL --> TX[Transactions]
  REL --> DS[Dead-Letter Handling]

  RMQ --> ADMIN[Administration]
  ADMIN --> VH[Virtual Hosts]
  ADMIN --> RA[RabbitAdmin]
  ADMIN --> CF[Connection Factory]
  ADMIN --> TLS[TLS Security]
