flowchart TD
    subgraph AgentLoop["Agent-Environment Interaction"]
        Env["Environment"] -->|"percepts"| Sensor["Sensors"]
        Sensor --> Agent["Agent\nAgent Function\nAgent Program"]
        Agent --> Actuator["Actuators"]
        Actuator -->|"actions"| Env
    end

    subgraph PEAS["PEAS Framework"]
        P["Performance\nSuccess metric"]
        E["Environment\nExternal world"]
        A["Actuators\nAction mechanisms"]
        S["Sensors\nPerception mechanisms"]
    end

    subgraph EnvProps["Environment Properties"]
        EP1["Fully Observable ↔ Partially Observable"]
        EP2["Deterministic ↔ Stochastic"]
        EP3["Episodic ↔ Sequential"]
        EP4["Static ↔ Dynamic"]
        EP5["Discrete ↔ Continuous"]
        EP6["Single Agent ↔ Multi Agent"]
    end

    subgraph AgentTypes["Agent Types (Increasing Complexity)"]
        AT1["Simple Reflex\nCondition-action rules\nCurrent percept only"]
        AT2["Model-Based Reflex\nInternal state\nWorld model"]
        AT3["Goal-Based\nGoal information\nPlanning ahead"]
        AT4["Utility-Based\nMaximize expected\nhappiness/utility"]
    end

    AT1 --> AT2 --> AT3 --> AT4

    style AgentLoop fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style PEAS fill:#fff3e0,stroke:#f57c00,color:#000
    style EnvProps fill:#fce4ec,stroke:#c62828,color:#000
