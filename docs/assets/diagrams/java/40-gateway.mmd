flowchart TB
  GW[API Gateway]
  GW --> ROUTE[Route Configuration]
  ROUTE --> YAML[YAML Routes]
  ROUTE --> RLB[RouteLocatorBuilder]

  GW --> PRED[Predicates]
  PRED --> PATH[Path]
  PRED --> METHOD[Method]
  PRED --> HEADER[Header]
  PRED --> QUERY[Query]
  PRED --> COOKIE[Cookie]
  PRED --> HOST[Host]
  PRED --> RA[RemoteAddr]
  PRED --> WEIGHT[Weight]
  PRED --> TIME[Temporal]

  GW --> FILT[Filters]
  FILT --> ADD[AddRequestHeader / ResponseHeader]
  FILT --> REWRITE[RewritePath]
  FILT --> STRIP[StripPrefix]
  FILT --> CB[CircuitBreaker]
  FILT --> RETRY[Retry]
  FILT --> RL[RequestRateLimiter]
  FILT --> CUSTOM[Custom GatewayFilter]
  FILT --> GLOBAL[GlobalFilter]

  GW --> ADV[Advanced]
  ADV --> RLIMIT[Rate Limiting]
  RLIMIT --> REDIS[Redis]
  RLIMIT --> KR[KeyResolver]
  ADV --> SECURE[OAuth2 Security]
  ADV --> REACT[WebFlux Architecture]
