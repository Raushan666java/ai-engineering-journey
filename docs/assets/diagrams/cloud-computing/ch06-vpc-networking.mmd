flowchart TD
    subgraph VPC["Virtual Private Cloud"]
        IG["Internet Gateway"] --> PubSubnet["Public Subnet\nWeb Servers\nLoad Balancers\nNAT Gateway"]
        PubSubnet --> PrivSubnet1["Private Subnet 1\nApplication Servers"]
        PrivSubnet1 --> PrivSubnet2["Private Subnet 2\nDatabases / Cache"]
    end

    subgraph Connectivity["Hybrid Connectivity"]
        VPN["Site-to-Site VPN\nIPsec over internet"] -.-> VPC
        DC["Direct Connect\nExpressRoute\nCloud Interconnect"] -.-> VPC
        Peering["VPC Peering\nTransit Gateway"] -.-> VPC
    end

    subgraph DNS["DNS & CDN"]
        Route53["Route53 / DNS\nLatency, Geo\nFailover routing"]
        CF["CloudFront / CDN\nEdge caching\nDDoS protection"]
    end

    Internet["Internet Users"] --> IG
    OnPrem["On-Premises DC"] --> VPN
    OnPrem --> DC

    style VPC fill:#e3f2fd,stroke:#1565c0,color:#000
    style Connectivity fill:#fff3e0,stroke:#f57c00,color:#000
    style DNS fill:#e8f5e9,stroke:#2e7d32,color:#000
    style IG fill:#fce4ec,stroke:#c62828,color:#000
