flowchart LR
  CLIENT[Client] --> UP[Upload Endpoint]
  CLIENT --> DL[Download Endpoint]

  UP --> MF[MultipartFile]
  MF --> PROC[Process Upload]
  PROC --> STORE[Storage Service]
  STORE --> FS[File System]
  STORE --> S3[AWS S3 / Cloud]
  STORE --> DB[Database BLOB]
  PROC --> VALID[Validation]
  VALID --> MB[Magic Bytes Check]
  VALID --> TYPE[Content Type]
  VALID --> SIZE[Size Limits]
  VALID --> SCAN[Malware Scan]
  PROC --> TRANSACT[Atomic Move Pattern]

  UP --> CFG[Multipart Config]
  CFG --> MAX[Max File Size]
  CFG --> REQ[Max Request Size]
  CFG --> TEMP[Temp Directory]

  DL --> RES[Resource Serving]
  RES --> ISR[InputStreamResource]
  RES --> UR[UrlResource]
  RES --> BAR[ByteArrayResource]
  DL --> HEADERS[Response Headers]
  HEADERS --> CT[Content-Type]
  HEADERS --> CD[Content-Disposition]
  DL --> STREAM[Streaming Options]
  STREAM --> SRB[StreamingResponseBody]
  STREAM --> CHUNK[Chunked Transfer]
  STREAM --> PROGRESS[Progress Tracking]

  DL --> STATIC[Static Resources]
  STATIC --> SRH[StaticResourceHandler]
  STATIC --> CACHE[Cache Headers]
