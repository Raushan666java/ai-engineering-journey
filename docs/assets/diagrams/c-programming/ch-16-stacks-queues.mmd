flowchart TD
    A["Stacks and Queues"] --> B["Stack ADT (LIFO)"]
    A --> C["Queue ADT (FIFO)"]
    A --> D["Comparison"]

    B --> B1["Core Operations"]
    B1 --> B1a["push(x)  add to top"]
    B1 --> B1b["pop()    remove from top"]
    B1 --> B1c["peek()   view top element"]
    B1 --> B1d["is_empty() check if empty"]
    B1 --> B1e["size()   number of elements"]
    B --> B2["Array-Based Stack"]
    B2 --> B2a["int data[] with top index"]
    B2 --> B2b["push: data[++top] = value"]
    B2 --> B2c["pop: return data[top--]"]
    B2 --> B2d["Fixed capacity, O(1) all ops"]
    B --> B3["Linked-List Stack"]
    B3 --> B3a["push at head of list"]
    B3 --> B3b["pop from head of list"]
    B3 --> B3c["Dynamic size, O(1) all ops"]
    B --> B4["Applications"]
    B4 --> B4a["Balanced parentheses checking"]
    B4 --> B4b["Expression evaluation (infix/postfix)"]
    B4 --> B4c["Shunting Yard Algorithm"]
    B4 --> B4d["Undo/Redo in editors"]
    B4 --> B4e["Function call stack"]

    C --> C1["Core Operations"]
    C1 --> C1a["enqueue(x)  add to rear"]
    C1 --> C1b["dequeue()   remove from front"]
    C1 --> C1c["front()     view front element"]
    C1 --> C1d["is_empty()  check if empty"]
    C --> C2["Array-Based Circular Queue"]
    C2 --> C2a["front and rear indices wrap around"]
    C2 --> C2b["enqueue: rear = (rear+1) mod capacity"]
    C2 --> C2c["dequeue: front = (front+1) mod capacity"]
    C2 --> C2d["Reuses vacated slots efficiently"]
    C --> C3["Linked-List Queue"]
    C3 --> C3a["front pointer and rear pointer"]
    C3 --> C3b["enqueue at rear, dequeue at front"]
    C3 --> C3c["Dynamic size, no capacity limit"]
    C --> C4["Applications"]
    C4 --> C4a["BFS in graphs"]
    C4 --> C4b["Print spooling"]
    C4 --> C4c["Task scheduling in OS"]
    C4 --> C4d["I/O buffering"]
    C4 --> C4e["Breadth-first tree traversal"]

    D --> D1["Stack: LIFO"]
    D1 --> D1a["Last In, First Out"]
    D --> D2["Queue: FIFO"]
    D2 --> D2a["First In, First Out"]
    D --> D3["Both O(1) for core operations"]
    D --> D4["Both can be array or linked-list based"]

    style A fill:#4a90d9,color:#fff
    style B fill:#e8a838,color:#fff
    style C fill:#5ba85a,color:#fff
