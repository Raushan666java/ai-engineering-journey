flowchart TD
    Internet["Internet\nUntrusted"] --> FW["Firewall\nPacket Filter\nStateful\nNGFW (DPI)"]
    FW --> DMZ["DMZ\nWeb Servers\nMail Servers"]
    DMZ --> IDS["IDS\nPassive monitoring\nAlerts on threats"]
    DMZ --> IPS["IPS\nInline blocking\nDrops malicious traffic"]
    IDS --> SOC["Security Team\nInvestigates alerts"]
    IPS --> Internal["Internal Network\nTrusted Zone"]

    subgraph VPNCon["VPN Connection"]
        VPN["VPN Gateway\nIPsec / WireGuard"]
        Remote["Remote User"] -->|"Encrypted Tunnel"| VPN
        VPN --> Internal
    end

    subgraph Wireless["Wireless Security"]
        WPA3["WPA3\nSimultaneous Auth of Equals"]
        EAP["802.1X / EAP\nEnterprise auth"]
    end

    style Internet fill:#fce4ec,stroke:#c62828,color:#000
    style FW fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style IDS fill:#fff3e0,stroke:#f57c00,color:#000
    style IPS fill:#e8f5e9,stroke:#2e7d32,color:#000
