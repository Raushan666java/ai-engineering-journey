flowchart TB
  APP[ApplicationContext]
  APP --> ACI[AnnotationConfigApplicationContext]
  APP --> XMLC[ClassPathXmlApplicationContext]
  APP --> WAC[WebApplicationContext]

  APP --> BEANS[Bean Definition]
  BEANS --> STEREO[Stereotype Annotations]
  STEREO --> COMP[Component]
  STEREO --> SERV[Service]
  STEREO --> REPO[Repository]
  STEREO --> CTRL[Controller]
  STEREO --> REST[RestController]
  BEANS --> FAC[Bean Factory Methods]
  BEANS --> SCAN[Component Scanning]

  APP --> WIRING[Dependency Injection]
  WIRING --> CONSTR[Constructor Injection]
  WIRING --> SETTER[Setter Injection]
  WIRING --> FIELD[Field Injection]
  WIRING --> QUAL[Qualifier]
  WIRING --> PRI[Primary]

  APP --> SCOPES[Bean Scopes]
  SCOPES --> SING[Singleton]
  SCOPES --> PROT[Prototype]
  SCOPES --> REQ[Request]
  SCOPES --> SESS[Session]
  SCOPES --> APPL[Application]
  SCOPES --> WS[WebSocket]

  APP --> LIFECYCLE[Lifecycle Hooks]
  LIFECYCLE --> PC[PostConstruct]
  LIFECYCLE --> PD[PreDestroy]
  LIFECYCLE --> IB[InitializingBean]
  LIFECYCLE --> DB[DisposableBean]
  LIFECYCLE --> SL[SmartLifecycle]

  APP --> COND[Conditional Beans]
  COND --> PROF[Profile]
  COND --> CONDON[ConditionalOnClass]
  COND --> CONDONM[ConditionalOnMissingBean]
  COND --> CONDONP[ConditionalOnProperty]
  COND --> CONDONEX[ConditionalOnExpression]

  APP --> EVENTS[Event System]
  EVENTS --> PUB[ApplicationEventPublisher]
  EVENTS --> EL[EventListener]
  EVENTS --> TEL[TransactionalEventListener]

  APP --> AOP[Aspect Oriented]
  AOP --> ASP[Aspect]
  AOP --> POINTCUT[Pointcut]
  AOP --> ADVICE[Advice Types]
  ADVICE --> BEFORE[Before]
  ADVICE --> AFTER[After]
  ADVICE --> AROUND[Around]
  ADVICE --> THROW[AfterThrowing]
