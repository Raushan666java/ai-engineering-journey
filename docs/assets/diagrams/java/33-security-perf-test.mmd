flowchart TB
  SPT[Security Performance Testing]
  SPT --> SEC[Security Testing]
  SEC --> MOCKU[WithMockUser]
  SEC --> ANON[WithAnonymousUser]
  SEC --> UD[WithUserDetails]
  SEC --> JWT[WithMockJwt]
  SEC --> O2[WithMockOAuth2Client]
  SEC --> MSEC[Method Security Tests]
  SEC --> CORS[CSRF / CORS Tests]

  SPT --> PERF[Performance Testing]
  PERF --> JMETER[JMeter]
  JMETER --> TG[Thread Group]
  JMETER --> SMP[Samplers]
  JMETER --> ASSERT[Assertions]
  JMETER --> LIST[Listeners / Reports]
  PERF --> GAT[Gatling]
  GAT --> SCEN[Scenario]
  GAT --> CHK[Checks]
  GAT --> FEED[Feeds / Injection]
  PERF --> PROFILE[Profiling Under Load]
  PROFILE --> CP[Connection Pool]
  PROFILE --> QP[Query Performance]
  PROFILE --> LAT[Latency Percentiles]

  SPT --> STRESS[Stress Testing Types]
  STRESS --> RAMP[Ramp-Up]
  STRESS --> SPIKE[Spike]
  STRESS --> SOAK[Soak / Endurance]

  SPT --> CHAOS[Chaos Engineering]
  CHAOS --> CMB[Chaos Monkey for Boot]
  CHAOS --> LAT2[Latency Injection]
  CHAOS --> EXC[Exception Injection]
  CHAOS --> SHUT[Service Shutdown]
