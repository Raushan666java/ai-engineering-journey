flowchart TB
  AUTOCFG[Spring Boot Auto-Configuration]
  AUTOCFG --> EAC[EnableAutoConfiguration]
  EAC --> AIS[AutoConfigurationImportSelector]
  AIS --> FACTORIES[spring.factories / AutoConfiguration.imports]
  FACTORIES --> CLASSES[Auto-Configuration Classes]

  CLASSES --> COND[Conditional Annotations]
  COND --> COC[ConditionalOnClass]
  COND --> COMB[ConditionalOnMissingBean]
  COND --> COP[ConditionalOnProperty]
  COND --> COR[ConditionalOnResource]
  COND --> COE[ConditionalOnExpression]
  COND --> COJ[ConditionalOnJndi]
  COND --> COJAVA[ConditionalOnJava]
  COND --> COSC[ConditionalOnSingleCandidate]
  COND --> COWAR[ConditionalOnWarDeployment]
  COND --> COCLOUD[ConditionalOnCloudPlatform]

  CLASSES --> ORDER[Auto-Configuration Ordering]
  ORDER --> AOB[AutoConfigureBefore]
  ORDER --> AOA[AutoConfigureAfter]
  ORDER --> AOO[AutoConfigureOrder]

  CLASSES --> EXAMPLES[Key Auto-Configurations]
  EXAMPLES --> DSAC[DataSourceAutoConfiguration]
  EXAMPLES --> JPAR[JpaRepositoriesAutoConfiguration]
  EXAMPLES --> SAC[SecurityAutoConfiguration]
  EXAMPLES --> WAC[WebMvcAutoConfiguration]

  AUTOCFG --> STARTERS[Custom Starters]
  STARTERS --> AM[Auto-Configure Module]
  STARTERS --> SM[Starter Module POM]
  STARTERS --> CFGP[ConfigurationProperties]
  STARTERS --> META[Configuration Metadata]

  AUTOCFG --> PROPS[Configuration Properties]
  PROPS --> CP[ConfigurationProperties prefix]
  PROPS --> ECB[EnableConfigurationProperties]
  PROPS --> CB[ConstructorBinding]
  PROPS --> RB[Relaxed Binding]
  PROPS --> DC[Duration / DataSize Conversion]

  AUTOCFG --> EXTEND[Extensions]
  EXTEND --> FA[FailureAnalyzer]
  EXTEND --> EPP[EnvironmentPostProcessor]
