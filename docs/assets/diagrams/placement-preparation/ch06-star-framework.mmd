flowchart TD
    Q["HR Question"] --> S["S - Situation\nSet the context\n'In my previous role...'"]
    S --> T["T - Task\nDescribe the challenge\n'I needed to...'"]
    T --> A["A - Action\nExplain what YOU did\n'I implemented...'"]
    A --> R["R - Result\nQuantify the outcome\n'Result: 30% improvement'"]

    Q --> Past["Tell me about yourself\nPast → Present → Future"]
    Q --> Weakness["Strengths/Weaknesses\nHonest weakness +\nimprovement plan"]
    Q --> Conflict["Conflict resolution\nSTAR + team outcome"]
    Q --> Why["Why this company?\nResearch + alignment"]

    style Q fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style S fill:#e8f5e9,stroke:#2e7d32,color:#000
    style T fill:#fff3e0,stroke:#f57c00,color:#000
    style A fill:#f3e5f5,stroke:#7b1fa2,color:#000
    style R fill:#fce4ec,stroke:#c62828,color:#000
