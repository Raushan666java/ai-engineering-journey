flowchart TD
    subgraph Block1["Block #1 (Genesis)"]
        H1["Block Header\nVersion | Timestamp\nPrev Hash: 0000...\nMerkle Root | Nonce"]
        T1["Transactions\nTx 1: Coinbase\n(50 BTC reward)"]
    end

    subgraph Block2["Block #2"]
        H2["Block Header\nVersion | Timestamp\nPrev Hash: A3B2...\nMerkle Root | Nonce"]
        T2["Transactions\nTx 2: Alice → Bob\nTx 3: Bob → Charlie"]
    end

    subgraph Block3["Block #3"]
        H3["Block Header\nVersion | Timestamp\nPrev Hash: C7D1...\nMerkle Root | Nonce"]
        T3["Transactions\nTx 4: Charlie → Dave\nTx 5: Dave → Eve"]
    end

    H1 -.->|"Hash → Prev Hash"| H2
    H2 -.->|"Hash → Prev Hash"| H3

    subgraph Types["Blockchain Types"]
        Pub["Public\nPermissionless\nAnyone can join"]
        Priv["Private\nPermissioned\nKnown participants"]
        Cons["Consortium\nMulti-org governance"]
    end

    subgraph Trilemma["Blockchain Trilemma"]
        Dec["Decentralization"]
        Sec["Security"]
        Scal["Scalability"]
        Dec --- Sec --- Scal --- Dec
    end

    style Block1 fill:#e3f2fd,stroke:#1565c0,color:#000
    style Block2 fill:#e8f5e9,stroke:#2e7d32,color:#000
    style Block3 fill:#fff3e0,stroke:#f57c00,color:#000
    style Types fill:#f3e5f5,stroke:#7b1fa2,color:#000
    style Trilemma fill:#fce4ec,stroke:#c62828,color:#000
