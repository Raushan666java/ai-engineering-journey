flowchart TD
    Data["Original Data\nN samples, D features"] --> Center["Center the Data\nSubtract mean\nfrom each feature"]
    Center --> Cov["Compute Covariance\nMatrix\n(D × D)"]
    Cov --> Eigen["Eigendecomposition\nFind eigenvectors &\neigenvalues"]
    Eigen --> Sort["Sort by Eigenvalue\nDescending order\nof variance explained"]
    Sort --> Select["Select Top K\nPrincipal Components\nKeep 95% variance"]
    Select --> Project["Project Data\nData × Top K eigenvectors\nReduced: N × K"]

    subgraph Variance["Explained Variance"]
        PC1["PC1: 60%"]
        PC2["PC2: 25%"]
        PC3["PC3: 10%"]
        PCrest["Rest: 5%"]
    end

    Select -.-> Variance

    style Data fill:#e3f2fd,stroke:#1565c0,color:#000
    style Center fill:#e8f5e9,stroke:#2e7d32,color:#000
    style Eigen fill:#fff3e0,stroke:#f57c00,color:#000
    style Project fill:#fce4ec,stroke:#c62828,color:#000,stroke-width:2px
