flowchart LR
    Input["Input Image\n(photo.jpg)"] --> Convert["Color Conversion\nBGR → Gray / HSV"]
    Convert --> Filter["Filtering\nGaussian Blur\nMedian Blur\nBilateral"]
    Filter --> Edge["Edge Detection\nCanny"]
    Filter --> Feature["Feature Detection\nSIFT / Harris"]
    Edge --> Segment["Segmentation\nThresholding\nContour Finding"]
    Feature --> Match["Feature Matching\nFLANN Matcher"]
    Segment --> Output["Output\nAnnotated Image"]
    Match --> Output

    Input --> Detect["Object Detection\nHaar Cascade / YOLO"]
    Detect --> Output

    Input --> Augment["Geometric Transform\nResize / Rotate / Crop\nPerspective Warp"]
    Augment --> Output

    style Input fill:#e3f2fd,stroke:#1565c0,color:#000
    style Output fill:#e8f5e9,stroke:#2e7d32,color:#000
    style Detect fill:#fff3e0,stroke:#f57c00,color:#000
    style Augment fill:#f3e5f5,stroke:#7b1fa2,color:#000
