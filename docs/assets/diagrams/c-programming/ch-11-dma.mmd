flowchart TD
    A["Dynamic Memory Allocation"] --> B["Why Dynamic?"]
    A --> C["Allocation Functions"]
    A --> D["Deallocation"]
    A --> E["Dynamic Array Pattern"]
    A --> F["Common Errors"]
    A --> G["Debugging Tools"]
    A --> H["Best Practices"]

    B --> B1["Size unknown at compile time"]
    B --> B2["Variable lifetime beyond function scope"]
    B --> B3["Heap memory persists until freed"]

    C --> C1["malloc(n)"]
    C --> C2["calloc(count, size)"]
    C --> C3["realloc(ptr, new_size)"]
    C1 --> C1a["Allocates n bytes uninitialized"]
    C1 --> C1b["Returns void* or NULL on failure"]
    C1 --> C1c["Always check return for NULL"]
    C2 --> C2a["Allocates and zero-initializes all bytes"]
    C2 --> C2b["Preferred when zero-init needed"]
    C3 --> C3a["Resizes existing allocation"]
    C3 --> C3b["May move block, copies old data"]
    C3 --> C3c["Use temp pointer: never ptr = realloc(ptr, n)"]
    C3 --> C3d["If ptr is NULL, behaves like malloc"]

    D --> D1["free(ptr)"]
    D --> D2["After free: dangling pointer"]
    D --> D3["Set ptr = NULL after freeing"]

    E --> E1["struct DynArray"]
    E1 --> E1a["int *data, size, capacity"]
    E --> E2["Doubling strategy"]
    E2 --> E2a["capacity = 0 ? 4 : capacity * 2"]
    E2 --> E2b["Amortized O(1) append"]

    F --> F1["Memory Leak"]
    F1 --> F1a["Allocated but never freed"]
    F1 --> F1b["Program consumes more memory over time"]
    F --> F2["Use-After-Free"]
    F2 --> F2a["Dereferencing freed pointer"]
    F2 --> F2b["Undefined behavior"]
    F --> F3["Double Free"]
    F3 --> F3a["Calling free twice on same pointer"]
    F3 --> F3b["Undefined behavior"]
    F --> F4["Buffer Overflow"]
    F4 --> F4a["Writing past allocated region"]
    F4 --> F4b["Corrupts heap metadata"]
    F --> F5["Freeing Non-Dynamic Memory"]
    F5 --> F5a["free() on stack or global pointer"]
    F5 --> F5b["Undefined behavior"]

    G --> G1["Valgrind --leak-check=full"]
    G1 --> G1a["Detects leaks, invalid accesses"]
    G1 --> G1b["Reports definitely lost, still reachable"]

    H --> H1["Always check return value for NULL"]
    H --> H2["Free in same scope when possible"]
    H --> H3["Set pointer to NULL after free"]
    H --> H4["Use temp pointer for realloc"]
    H --> H5["Document ownership semantics"]
