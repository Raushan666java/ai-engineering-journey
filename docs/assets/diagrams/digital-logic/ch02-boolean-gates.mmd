flowchart TD
    subgraph BoolAlg["Boolean Algebra Laws"]
        Identity["A + 0 = A<br/>A · 1 = A"]
        Null["A + 1 = 1<br/>A · 0 = 0"]
        Idempotent["A + A = A<br/>A · A = A"]
        Involution["(A')' = A"]
        Complement["A + A' = 1<br/>A · A' = 0"]
        Commutative["A + B = B + A<br/>A · B = B · A"]
        Associative["(A+B)+C = A+(B+C)<br/>(A·B)·C = A·(B·C)"]
        Distributive["A·(B+C) = A·B + A·C<br/>A + (B·C) = (A+B)·(A+C)"]
        DeMorgans["(A·B)' = A' + B'<br/>(A+B)' = A' · B'"]
        Absorp["A + A·B = A<br/>A·(A+B) = A"]
    end

    subgraph Gates["Logic Gates"]
        AND["AND<br/>Y = A · B"]
