flowchart TB
  MOCK[Mockito Mocking Framework]
  MOCK --> CREATE[Mock Creation]
  CREATE --> MOCK[Mock]
  MOCK --> SPY[Spy / Partial Mock]
  MOCK --> INJECT[InjectMocks]
  MOCK --> CAPT[ArgumentCaptor]
  MOCK --> ANNON[Annotations]
  ANNON --> MO[EnableMockitoJUnitRunner]
  ANNON --> MR[MockitoRule]
  ANNON --> SE[Strict Stubbing]

  MOCK --> STUB[Stubbing]
  STUB --> WHEN[when thenReturn]
  STUB --> DO[doThrow doReturn]
  STUB --> ANS[Answer / thenAnswer]
  STUB --> CALL[thenCallRealMethod]

  MOCK --> VERIFY[Verification]
  VERIFY --> TIM[times / never]
  VERIFY --> ATL[atLeast / atMost]
  VERIFY --> DEL[delay / timeout]
  VERIFY --> IGNORE[IgnoreStubs]
  VERIFY --> NOINT[verifyNoInteractions]

  MOCK --> MATCH[Argument Matchers]
  MATCH --> ANY[anyInt / anyString]
  MATCH --> EQ[eq]
  MATCH --> STARTS[startswith]
  MATCH --> END[endsWith]
  MATCH --> CUST[Custom Matcher]

  MOCK --> ADV[Advanced Features]
  ADV --> STATIC[mockStatic]
  ADV --> CONS[mockConstruction]
  ADV --> BDD[BDDMockito]
  ADV --> RESET[reset]
  ADV --> INLINE[Mockito Inline]

  MOCK --> BEST[Best Practices]
  BEST --> UNIT[Unit Test Isolation]
  BEST --> NOT[Don't Mock Types You Don't Own]
  BEST --> CLEAN[Clean Test Code]
