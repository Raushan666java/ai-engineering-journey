flowchart TD
    subgraph DDL["DDL - Data Definition"]
        Create["CREATE TABLE Students (<br/>    id INT PRIMARY KEY,<br/>    name VARCHAR(50) NOT NULL<br/>);"]
        Alter["ALTER TABLE Students<br/>ADD email VARCHAR(100);"]
        Drop["DROP TABLE Students;<br/>removes table + data"]
        Truncate["TRUNCATE TABLE Students;<br/>removes all rows, keeps structure"]
    end

    subgraph DML["DML - Data Manipulation"]
        Insert["INSERT INTO Students<br/>VALUES (1, 'Alice');"]
