flowchart TB
  KAFKA[Apache Kafka]
  KAFKA --> CORE[Core Concepts]
  CORE --> TOP[Topics]
  CORE --> PART[Partitions]
  CORE --> OFF[Offsets]
  CORE --> BROK[Brokers]
  CORE --> REPL[Replication]
  CORE --> KR[KRaft Consensus]

  KAFKA --> PROD[Producers]
  PROD --> KT[KafkaTemplate]
  PROD --> CALL[Callbacks]
  PROD --> PARTI[Custom Partitioners]
  PROD --> KEY[Keys / Headers]
  PROD --> IDEM[Idempotent Producer]
  PROD --> TRANS[Transactional Producer]

  KAFKA --> CONS[Consumers]
  CONS --> KL[KafkaListener]
  CONS --> CG[Consumer Groups]
  CONS --> BATCH[Batch Listening]
  CONS --> ACK[AckMode Strategies]
  CONS --> SEEK[Seek Operations]
  CONS --> EOS[Exactly-Once Semantics]

  KAFKA --> ERROR[Error Handling]
  ERROR --> DEH[DefaultErrorHandler]
  ERROR --> DLP[DeadLetterPublishingRecoverer]
  ERROR --> RET[RetryableTopic]

  KAFKA --> SCHEMA[Schema Registry]
  SCHEMA --> AVRO[Avro]
  SCHEMA --> PROTO[Protobuf]
  SCHEMA --> JSONS[JSON Schema]

  KAFKA --> STREAMS[Kafka Streams]
  STREAMS --> KSTR[KStream]
  STREAMS --> KTAB[KTable]
  STREAMS --> AGGR[Aggregations]
  STREAMS --> JOIN[Joins]
  STREAMS --> WIND[Window Operations]

  KAFKA --> ADMIN[Administration]
  ADMIN --> TOPIC[Topic Config]
  ADMIN --> CLEAN[Cleanup Policy]
  ADMIN --> RETEN[Retention]
  ADMIN --> ISR[min.insync.replicas]
