flowchart TD
    subgraph NonComp["Non-Comparison Sorting\nO(n) - Bypasses Ω(n log n) bound"]
        CS["Counting Sort\nIntegers in range [0,k-1]\nCount frequencies → Prefix sum → Place\nO(n+k) time, stable"]
        RS["Radix Sort\nLSD-first digit by digit\nStable sort on each digit\nO(d(n+r)) time"]
        BKS["Bucket Sort\nUniform [0,1) distribution\nn buckets → Sort each → Concatenate\nO(n) expected"]
    end

    subgraph When["When to Use"]
        WC["Small integer keys\nk = O(n)"]
        WR["Fixed-width keys\nIntegers, short strings"]
        WB["Uniform distribution\nKnown range"]
    end

    CS -->|"Best for"| WC
    RS -->|"Best for"| WR
    BKS -->|"Best for"| WB

    subgraph Table["Time & Space Comparison"]
        TCS["Counting: O(n+k) time, O(k) space"]
        TRS["Radix: O(d·n) time, O(n) space"]
        TBK["Bucket: O(n) expected, O(n) space"]
    end

    style NonComp fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style When fill:#fff3e0,stroke:#f57c00,color:#000
    style Table fill:#e8f5e9,stroke:#2e7d32,color:#000
