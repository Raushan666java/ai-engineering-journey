flowchart TD
    subgraph GRC["Governance, Risk & Compliance"]
        Gov["Governance\nBoard & exec oversight\nStrategic direction\nPolicies & standards"]
        Risk["Risk Management\nIdentify → Assess → Respond"]
        Comp["Compliance\nGDPR, HIPAA, PCI-DSS\nLegal requirements\nAudits"]
    end

    subgraph RiskProcess["Risk Management Process"]
        ID["Identify\nThreats & vulnerabilities"]
        Assess["Assess\nLikelihood × Impact\nQualitative / Quantitative"]
        Respond["Respond\nMitigate / Avoid\nTransfer / Accept"]
        Monitor["Monitor\nContinuous review"]
    end

    subgraph Frameworks["Security Frameworks"]
        NIST["NIST CSF\nIdentify, Protect, Detect\nRespond, Recover"]
        ISO["ISO 27001\nISMS\nPlan-Do-Check-Act"]
        CIS["CIS Controls\n18 prioritized actions"]
    end

    ID --> Assess --> Respond --> Monitor
    Monitor -.->|"Re-assess"| ID

    style GRC fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style RiskProcess fill:#fce4ec,stroke:#c62828,color:#000
    style Frameworks fill:#e8f5e9,stroke:#2e7d32,color:#000
