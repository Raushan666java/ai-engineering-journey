{
  "name": "monitask-desktop-agent",
  "version": "1.0.0",
  "description": "Monitask Desktop Tracking Agent",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev"
  },
  "build": {
    "appId": "com.monitask.desktop-agent",
    "productName": "Monitask Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron": "^25.0.0",
    "axios": "^1.4.0",
    "screenshot-desktop": "^1.12.7",
    "active-win": "^7.8.0",
    "systeminformation": "^5.18.7",
    "robotjs": "^0.6.0",
    "node-machine-id": "^1.1.12",
    "electron-store": "^8.1.0",
    "auto-launch": "^5.0.5"
  },
  "devDependencies": {
    "electron-builder": "^24.4.0"
  }
}
