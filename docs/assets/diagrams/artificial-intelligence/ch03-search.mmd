flowchart TD
    subgraph Uninformed["Uninformed Search"]
        BFS["BFS\nQueue, shallowest first\nComplete, optimal\nO(b^d) time & space"]
        DFS["DFS\nStack, deepest first\nNot complete\nO(b^m) time, O(bm) space"]
        UCS["UCS\nPriority queue by g(n)\nComplete, optimal\nSimilar to Dijkstra"]
    end

    subgraph Informed["Informed Search"]
        Greedy["Greedy Best-First\nPriority queue by h(n)\nFast, not optimal\nCan get stuck"]
        AStar["A* Search\nf(n) = g(n) + h(n)\nComplete & optimal\nif h is admissible\nO(b^d) time"]
    end

    subgraph Heuristics["Heuristic Properties"]
        Adm["Admissible\nh(n) never overestimates\nEnsures A* optimality"]
        Con["Consistent (Monotonic)\nh(n) ≤ c(n,a,n') + h(n')\nTriangle inequality"]
        Dom["Dominance\nh₂ dominates h₁ if\nh₂(n) ≥ h₁(n) for all n"]
    end

    style Uninformed fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style Informed fill:#fff3e0,stroke:#f57c00,color:#000
    style Heuristics fill:#e8f5e9,stroke:#2e7d32,color:#000
