flowchart LR
    subgraph Events["Event Sources"]
        HTTP["HTTP Request\nAPI Gateway"]
        S3["Object Upload\nS3 / Blob Storage"]
        DB["DB Change\nDynamoDB Streams"]
        Queue["Queue Message\nSQS / Pub-Sub"]
        Cron["Scheduled\nEventBridge / CloudWatch"]
    end

    subgraph Compute["Serverless Compute"]
        Lambda["AWS Lambda\nAzure Functions\nCloud Functions"]
    end

    subgraph Services["Managed Services"]
        Store["Object Storage\nS3 / Blob"]
        DDB["NoSQL DB\nDynamoDB / Cosmos"]
        SQS["Queue\nSQS / Queue Storage"]
        SES["Email\nSES / SendGrid"]
    end

    Events -->|"Trigger"| Lambda
    Lambda -->|"Read/Write"| Services
    Lambda -->|"Return"| HTTP

    style Events fill:#e3f2fd,stroke:#1565c0,color:#000
    style Compute fill:#e8f5e9,stroke:#2e7d32,color:#000,stroke-width:2px
