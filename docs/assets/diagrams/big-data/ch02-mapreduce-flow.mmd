flowchart LR
    Input["Input Data\nHDFS Blocks"] --> Split["InputFormat\nSplits data into\nlogical splits"]
    Split --> Map["MAP Phase\nMapper 1\nMapper 2\nMapper N\n(key, value) pairs"]

    Map --> Shuffle["Shuffle & Sort\nPartition\nGroup by key\nSort within partition"]

    Shuffle --> Reduce["REDUCE Phase\nReducer 1\nReducer 2\nReducer N\nAggregate values"]

    Reduce --> Output["Output\nHDFS / Part file"]

    style Input fill:#e3f2fd,stroke:#1565c0,color:#000
    style Map fill:#e8f5e9,stroke:#2e7d32,color:#000
    style Shuffle fill:#fff3e0,stroke:#f57c00,color:#000
    style Reduce fill:#f3e5f5,stroke:#7b1fa2,color:#000
    style Output fill:#fce4ec,stroke:#c62828,color:#000
