flowchart TD
    subgraph IR["Incident Response Lifecycle\nNIST SP 800-61"]
        Prep["Preparation\nCSIRT team\nTools, playbooks"]
        Detect["Detection & Analysis\nIdentify incident\nDetermine scope"]
        Contain["Contain, Eradicate\nRecover\nStop spread, Remove\nalonged systems"]
        Post["Post-Incident\nLessons learned\nImprove defenses"]
    end

    Prep --> Detect --> Contain --> Post
    Post -.->|"Feedback"| Prep

    subgraph Volatility["Order of Volatility"]
        V1["1. CPU Cache / Registers\nMost volatile"]
        V2["2. System Memory (RAM)\nRunning processes\nNetwork connections"]
        V3["3. Temporary Files\nSwap, /tmp"]
        V4["4. Hard Drive\nPersistent storage"]
        V5["5. Backups / Logs\nLeast volatile"]
    end

    subgraph Forensics["Forensic Artifacts"]
        Mem["Memory\nProcesses\nOpen sockets\nEncryption keys"]
        FS["File System\nTimestamps\nDeleted files\nFile carving"]
        Net["Network\nPCAP\nFlow logs\nDNS queries"]
    end

    style IR fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style Volatility fill:#fce4ec,stroke:#c62828,color:#000
    style Forensics fill:#e8f5e9,stroke:#2e7d32,color:#000
