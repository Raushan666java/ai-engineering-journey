flowchart TD
    A["C Operators"] --> B["Arithmetic"]
    A --> C["Relational"]
    A --> D["Logical"]
    A --> E["Bitwise"]
    A --> F["Assignment"]
    A --> G["Ternary ?:"]
    A --> H["Comma ,"]
    A --> I["sizeof"]

    B --> B1["+  -  *  /  %"]
    B --> B2["++  --  (prefix vs postfix)"]
    B1 --> B1a["Integer division truncates toward zero"]
    B1 --> B1b["Modulus % requires integer operands"]

    C --> C1["==  !=  &lt;  &gt;  &lt;=  &gt;="]
    C --> C2["Yields int: 1 (true) or 0 (false)"]
    C --> C3["Common pitfall: = vs =="]

    D --> D1["&&  logical AND"]
    D --> D2["||  logical OR"]
    D --> D3["!   logical NOT"]
    D --> D4["Short-circuit evaluation"]
    D4 --> D4a["&& stops on first false"]
    D4 --> D4b["|| stops on first true"]

    E --> E1["&amp;  bitwise AND"]
    E --> E2["|  bitwise OR"]
    E --> E3["^  XOR"]
    E --> E4["~  ones complement"]
    E --> E5["&lt;&lt;  left shift"]
    E --> E6["&gt;&gt;  right shift"]
    E --> E7["Common flag operations"]
    E7 --> E7a["Check: flags &amp; (1 &lt;&lt; n)"]
    E7 --> E7b["Set:   flags |= (1 &lt;&lt; n)"]
    E7 --> E7c["Clear: flags &amp;= ~(1 &lt;&lt; n)"]
    E7 --> E7d["Toggle: flags ^= (1 &lt;&lt; n)"]

    F --> F1["=  simple assignment"]
    F --> F2["Compound: +=  -=  *=  /=  %="]
    F --> F3["Compound bitwise: &amp;=  |=  ^=  &lt;&lt;=  &gt;&gt;="]

    G --> G1["condition ? expr_true : expr_false"]
    G --> G2["Compact if-else that yields a value"]

    H --> H1["Evaluates both operands"]
    H --> H2["Returns value of right operand"]
    H --> H3["Common in for loops: int i=0, j=0"]

    I --> I1["sizeof(type) or sizeof expr"]
    I --> I2["Returns size_t at compile time"]

    J["Precedence (Level 1 highest)"] --> J1["L1: () [] . -&gt; postfix ++ --"]
    J --> J2["L2: prefix ++ --  + -  ! ~  &amp; *  sizeof"]
    J --> J3["L3: *  /  %"]
    J --> J4["L4: +  -"]
    J --> J5["L5: &lt;&lt;  &gt;&gt;"]
    J --> J6["L6-7: &lt; &gt; &lt;= &gt;=  == !="]
    J --> J7["L8-12: &amp;  ^  |  &amp;&amp;  ||"]
    J --> J8["L13-15: ?:  =  ,"]
