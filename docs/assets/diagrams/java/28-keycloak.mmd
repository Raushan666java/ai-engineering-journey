flowchart TB
  KC[Keycloak Identity Federation]
  KC --> SETUP[Keycloak Setup]
  SETUP --> DOCKER[Docker Compose]
  SETUP --> ADMIN[Admin Console]
  SETUP --> REALM[Realm Configuration]
  SETUP --> CLIENTS[Client Configuration]
  CLIENTS --> PUB[Public Clients]
  CLIENTS --> CONF[Confidential Clients]

  KC --> AUTH[Authentication]
  AUTH --> OIDC[OpenID Connect]
  AUTH --> SAML[SAML 2.0]
  AUTH --> SOCIAL[Social Login]
  SOCIAL --> GOOGLE[Google]
  SOCIAL --> GITHUB[GitHub]

  KC --> USERS[User Management]
  USERS --> LOCAL[Local Users]
  USERS --> FED[User Federation]
  FED --> LDAP[LDAP / AD Sync]
  USERS --> ROLES[Roles]
  USERS --> GROUPS[Groups]

  KC --> SPRING[Spring Boot Integration]
  SPRING --> OAUTH2[OAuth2 Resource Server]
  SPRING --> TOKEN[Token Exchange]
  SPRING --> ADAPTER[Legacy Adapter]

  KC --> FINE[Fine-Grained Authz]
  FINE --> RES[Resources]
  FINE --> SCOPE[Scopes]
  FINE --> PERM[Permissions]
  FINE --> POLICY[Policies]
  FINE --> UMA[UMA 2.0]

  KC --> BROKER[Identity Brokering]
  BROKER --> FLOW[First Broker Login]
  BROKER --> MAPPER[Attribute Mappers]
