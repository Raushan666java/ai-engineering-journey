flowchart TB
  ASYNC[Async Processing Events]
  ASYNC --> ENABLE[EnableAsync]
  ASYNC --> METH[Async Methods]
  METH --> VOID[Void Methods]
  METH --> FUT[CompletableFuture]
  METH --> LF[ListenableFuture]

  ASYNC --> TPE[Thread Pool]
  TPE --> TTE[ThreadPoolTaskExecutor]
  TPE --> CORE[Core Pool Size]
  TPE --> MAX[Max Pool Size]
  TPE --> QUEUE[Queue Capacity]
  TPE --> KEEP[Keep-Alive]
  TPE --> REJECT[Rejection Policy]

  ASYNC --> ERROR[Error Handling]
  ERROR --> AUCHE[AsyncUncaughtExceptionHandler]
  ERROR --> CFERR[CompletableFuture Error Recovery]

  ASYNC --> EVENTS[Application Events]
  EVENTS --> PUB[Event Publisher]
  PUB --> AEP[ApplicationEventPublisher]
  PUB --> EVENT[Custom Event Object]
  EVENTS --> LIST[Event Listeners]
  LIST --> EL[EventListener]
  LIST --> SPEL[SpEL Conditions]
  LIST --> ORDER[Ordering]
  LIST --> ASYNCEL[Async Event Listener]

  ASYNC --> TEL[TransactionalEventListener]
  TEL --> PHASE[Phase Control]
  PHASE --> AC[AFTER_COMMIT]
  PHASE --> AR[AFTER_ROLLBACK]
  PHASE --> ACMP[AFTER_COMPLETION]
  PHASE --> BCOM[BEFORE_COMMIT]

  ASYNC --> BEST[Design Patterns]
  BEST --> PAY[Event Payload Design]
  BEST --> BATCH[Event Batching]
  BEST --> SOURC[Event Sourcing Basics]
