        C2 --> L4["2"] & L5["4"] & L6["6"]
        C3 --> L7["14"] & L8["5"] & L9["2"]
    end

    subgraph CSP["Constraint Satisfaction"]
        CSPDef["Variables X\nDomains D\nConstraints C\nSolution = consistent assignment"]
        BT["Backtracking Search\nDFS with consistency checks\nVariable ordering (MRV)\nValue ordering (LCV)"]
        AC["Arc Consistency\nAC-3 algorithm\nRemove inconsistent values\nO(n²d³) time"]
    end

