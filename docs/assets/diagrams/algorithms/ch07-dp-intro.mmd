flowchart TD
    subgraph DP["Dynamic Programming Foundations"]
        direction TB
        PR["Problem Structure\nOptimal Substructure ✓\nOverlapping Subproblems ✓"]
        AP["Approaches"]
        Fib["Fibonacci Numbers\nNaive: O(2ⁿ)\nDP: O(n) time, O(1) space\nExponential improvement!"]
        RC["Rod Cutting\nr[n] = max(p[i] + r[n-i])\nO(n²) time"]
    end

    subgraph Implement["Implementation Methods"]
        Memo["Top-Down (Memoization)\nRecursion + cache\nOnly solves needed subproblems"]
        Tab["Bottom-Up (Tabulation)\nIterative table-filling\nAll subproblems solved\nEasy reconstruction"]
    end

    PR --> AP --> Memo
    AP --> Tab

    subgraph Steps["4-Step DP Method"]
        S1["1. Characterize\nStructure of optimal solution"]
        S2["2. Define\nRecursive value definition"]
        S3["3. Compute\nBottom-up table filling"]
        S4["4. Construct\nReconstruct optimal solution"]
    end

    S1 --> S2 --> S3 --> S4

    style DP fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
    style Implement fill:#fff3e0,stroke:#f57c00,color:#000
