    J --> K["Business Logic<br/>Service Layer / Action"]
    K --> L["Response<br/>View / JSON / Redirect / Stream"]
    L --> M["Middleware Response<br/>Reverse order"]
    M --> N["Kernel terminate()<br/>Terminable Middleware"]

