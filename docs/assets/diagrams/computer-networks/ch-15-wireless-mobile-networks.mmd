flowchart TD
    subgraph WLAN["Wireless LANs (IEEE 802.11)"]
        direction TB
        STD["802.11 Standards Evolution"]
        A["802.11a<br/>5 GHz, 54 Mbps, OFDM"]
        B["802.11b<br/>2.4 GHz, 11 Mbps, DSSS"]
        G["802.11g<br/>2.4 GHz, 54 Mbps, OFDM"]
        N["802.11n (WiFi 4)<br/>2.4/5 GHz, 600 Mbps<br/>MIMO, 4 streams"]
        AC["802.11ac (WiFi 5)<br/>5 GHz, 6.9 Gbps<br/>MU-MIMO, 160 MHz"]
        AX["802.11ax (WiFi 6)<br/>2.4/5/6 GHz, 9.6 Gbps<br/>OFDMA, 1024-QAM"]
        BE["802.11be (WiFi 7)<br/>2.4/5/6 GHz, 46 Gbps<br/>4096-QAM, 320 MHz"]
        STD --> A & B & G --> N --> AC --> AX --> BE

        MAC["802.11 MAC Sublayer"]
        CSMA["CSMA/CA<br/>carrier sense + random backoff"]
        RTS["RTS/CTS exchange<br/>hidden terminal solution"]
        FRAG["Fragmentation<br/>reduce corruption probability"]
        PWR["Power Management<br/>doze state, beacon wake"]
        MAC --> CSMA & RTS & FRAG & PWR

        SEC["WiFi Security Evolution"]
        WEP["WEP<br/>RC4, 40-bit key<br/>COMPLETELY BROKEN"]
        WPA["WPA<br/>TKIP (temporal key)<br/>stopgap measure"]
        WPA2["WPA2 (802.11i)<br/>AES-CCMP, 128-bit<br/>current minimum"]
        WPA3["WPA3<br/>SAE handshake<br/>forward secrecy"]
        SEC --> WEP --> WPA --> WPA2 --> WPA3
    end

    subgraph BT["Bluetooth (IEEE 802.15.1)"]
        FHSS["Frequency Hopping<br/>79 channels, 1600 hops/s<br/>2.4 GHz ISM band"]
        PICONET["Piconet<br/>1 master + 7 active slaves<br/>master coordinates all traffic"]
        SCATTER["Scatternet<br/>multiple interconnected piconets<br/>shared slave nodes"]
        VER["Versions"]
        BR["BR/EDR (classic)<br/>1-3 Mbps, audio"]
        BLE["BLE 4.0<br/>1 Mbps, IoT, low power"]
        BT5["Bluetooth 5<br/>2 Mbps, mesh, LE Audio"]
        FHSS --> PICONET
        PICONET --> SCATTER
        VER --> BR & BLE & BT5
    end

    subgraph CELL["Cellular Networks"]
        direction TB
        LTE["4G / LTE<br/>OFDMA downlink, SC-FDMA uplink<br/>MIMO 8x8, carrier aggregation"]
        LTEARCH["LTE Architecture"]
        UE["UE (User Equipment)"]
        ENB["eNodeB (base station)"]
        EPC["EPC (Evolved Packet Core)"]
        MME["MME (mobility mgmt)"]
        SGW["SGW (serving gateway)"]
        PGW["PGW (packet gateway)"]
        LTEARCH --> UE --> ENB --> EPC
        EPC --> MME & SGW & PGW

        NR["5G New Radio<br/>eMBB: 20 Gbps, uRLLC: 1ms, mMTC: 1M/km²"]
        SGARCH["5G Core (SBA)"]
        AMF["AMF (access & mobility)"]
        SMF["SMF (session mgmt)"]
        UPF["UPF (user plane)"]
        PCF["PCF (policy control)"]
        NRF["NRF (service discovery)"]
        SLICE["Network Slicing"]
        EMBB["eMBB - broadband"]
        URLLC["uRLLC - low latency"]
        MMTC["mMTC - massive IoT"]
        BEAM["Massive MIMO beamforming"]
        SGARCH --> AMF & SMF & UPF & PCF & NRF
        NR --> SLICE & BEAM
        SLICE --> EMBB & URLLC & MMTC
    end

    subgraph MOB["Mobility Management"]
        HO["Handover Types"]
        HARD["Hard Handover<br/>break-before-make<br/>used in GSM/LTE"]
        SOFT["Soft Handover<br/>make-before-break<br/>used in CDMA"]
        HORIZ["Horizontal<br/>same technology"]
        VERT["Vertical<br/>WiFi ↔ 5G"]
        LOC["Location Management"]
        TA["Tracking Area (TA)"]
        TAU["Tracking Area Update<br/>mobile crosses TA boundary"]
        PAGE["Paging<br/>all cells in last known TA"]
        ROAM["Roaming<br/>visited network ←→ home HSS"]
        HO --> HARD & SOFT & HORIZ & VERT
        LOC --> TA --> TAU & PAGE
        ROAM
    end