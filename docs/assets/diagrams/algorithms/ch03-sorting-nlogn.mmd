flowchart TD
    subgraph Sorting["Comparison-Based Sorting\nΩ(n log n) Lower Bound"]
        direction TB
        MS["Merge Sort\nDivide → Recursively sort → Merge\nΘ(n log n) all cases\nStable, O(n) space"]
        QS["Quick Sort\nPartition → Recursively sort\nΘ(n log n) avg, O(n²) worst\nIn-place, not stable"]
        HS["Heap Sort\nBuild max-heap → Extract\nΘ(n log n) all cases\nIn-place, not stable"]
    end

    subgraph DecisionTree["Decision Tree Model"]
        D1["a₁ < a₂?"] -->|"Yes"| D2["a₂ < a₃?"]
        D1 -->|"No"| D3["a₁ < a₃?"]
        D2 -->|"Yes"| L1["1,2,3"]
        D2 -->|"No"| L2["1,3,2"]
        D3 -->|"Yes"| L3["3,1,2"]
        D3 -->|"No"| L4["3,2,1"]
    end

    subgraph Pivot["Pivot Strategies"]
        Rand["Random pivot\nExpected O(n log n)"]
        M3["Median-of-three\nAvoids sorted worst-case"]
    end

