flowchart TD
    subgraph MST["Minimum Spanning Tree"]
        direction TB
        KR["Kruskal\nSort edges by weight\nAdd smallest if no cycle\nUnion-Find for cycle check\nO(E log E)"]
        PR["Prim\nGrow from start vertex\nAdd min-weight crossing edge\nMin-priority queue\nO(E log V)"]
        BR["Boruvka\nParallel: each component\nadds its cheapest edge\nO(E log V)"]
    end

    subgraph Properties["Key Properties"]
        CP["Cut Property\nMin-weight edge crossing\nany cut is in some MST"]
        CYP["Cycle Property\nMax-weight edge in any\ncycle is in no MST"]
    end

    subgraph Apps["Applications"]
        A1["Network Design\nCable routing, circuits"]
        A2["Clustering\nMax-spacing k-clustering"]
        A3["Approximation\nTSP 2-approximation"]
    end

    Properties --> MST
    MST --> Apps

