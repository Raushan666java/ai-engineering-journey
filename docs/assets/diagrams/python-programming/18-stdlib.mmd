mindmap
  root((Python Standard Library))
    OS and System
      os: environment, paths, processes
      sys: argv, path, version, exit
      shutil: copy, move, rmtree, archives
    Filesystem
      pathlib: object-oriented paths
      glob: pattern file matching
      tempfile: temporary files
    Dates and Time
      datetime: date, time, datetime, timedelta
      time: sleep, perf_counter
      calendar: month, isleap
    Text Processing
      re: regular expressions
      string: constants, Formatter
      difflib: diff and sequence matching
    Data Structures
      collections: deque, Counter, defaultdict
      heapq: priority queue
      bisect: sorted list operations
    Functional Programming
      itertools: count, cycle, chain, groupby
      functools: partial, lru_cache, reduce
      operator: itemgetter, attrgetter
    Data Serialization
      json: load, dump
      csv: reader, writer
      pickle: binary serialization
    Math and Statistics
      math: sin, cos, sqrt, pi
      random: randint, choice, shuffle
      statistics: mean, median, stdev
    CLI and Logging
      argparse: command-line arguments
      logging: debug, info, error
      typing: type hints
    Networking
      socket: low-level networking
      urllib: URL handling
      http.server: simple HTTP server
