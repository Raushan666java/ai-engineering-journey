flowchart TB
  POM[Maven POM]
  POM --> CORD[Coordinates]
  CORD --> GID[groupId]
  CORD --> AID[artifactId]
  CORD --> VER[version]
  CORD --> PKG[packaging]

  POM --> PARENT[Parent POM]
  PARENT --> SPRING[spring-boot-starter-parent]
  PARENT --> CORP[Corporate Parent]
  PARENT --> PLUGIN[pluginManagement]

  POM --> DEPS[Dependencies]
  DEPS --> SCOPE[Scopes]
  SCOPE --> COMPILE[compile]
  SCOPE --> PROVIDED[provided]
  SCOPE --> RUNTIME[runtime]
  SCOPE --> TEST[test]
  SCOPE --> SYSTEM[system]
  DEPS --> EXCL[Exclusions]
  DEPS --> OPT[Optional Dependencies]
  DEPS --> BOM[Bill of Materials]

  POM --> BUILD[Build]
  BUILD --> LIFECYCLE[Lifecycle]
  LIFECYCLE --> VALIDATE[validate]
  LIFECYCLE --> COMPILE[compile]
  LIFECYCLE --> TEST[test]
  LIFECYCLE --> PACKAGE[package]
  LIFECYCLE --> VERIFY[verify]
  LIFECYCLE --> INSTALL[install]
  LIFECYCLE --> DEPLOY[deploy]
  BUILD --> PLUGINS[Plugins]
  PLUGINS --> COMPILER[maven-compiler-plugin]
  PLUGINS --> SUREFIRE[maven-surefire-plugin]
  PLUGINS --> FAILSAFE[maven-failsafe-plugin]
  PLUGINS --> SHADE[maven-shade-plugin]
  PLUGINS --> ASSEMBLY[maven-assembly-plugin]
  PLUGINS --> SPRINGBT[spring-boot-maven-plugin]

  POM --> PROFILES[Profiles]
  PROFILES --> ACTIVATION[Activation]
  ACTIVATION --> JDK[By JDK]
  ACTIVATION --> OS[By OS]
  ACTIVATION --> PROP[By Property]
  ACTIVATION --> FILE[By File]

  POM --> MODULES[Multi-Module]
  MODULES --> AGG[Aggregator POM]
  MODULES --> REACTOR[Reactor Build]
  MODULES --> CITEST[CI-Friendly Versions]

  POM --> REPOS[Repositories]
  REPOS --> LOCAL[Local .m2]
  REPOS --> CENTRAL[Maven Central]
  REPOS --> PRIVATE[Private / Nexus]
  REPOS --> MIRRORS[Mirrors]
