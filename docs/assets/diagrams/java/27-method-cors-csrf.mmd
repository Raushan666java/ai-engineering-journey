flowchart TB
  SEC[Method Security CORS CSRF]

  SEC --> METHOD[Method Security]
  METHOD --> EMS[EnableMethodSecurity]
  METHOD --> PRE[PreAuthorize]
  PRE --> SPRL[SpEL Expressions]
  SPRL --> HASR[hasRole]
  SPRL --> HASA[hasAuthority]
  SPRL --> HASP[hasPermission]
  SPRL --> AUTH[authentication / principal]
  METHOD --> POST[PostAuthorize]
  METHOD --> PF[PreFilter / PostFilter]
  METHOD --> CUS[Custome Meta-Annotations]
  CUS --> IA[IsAdmin]
  METHOD --> PE[PermissionEvaluator]
  METHOD --> LEGACY[Secured / RolesAllowed]

  SEC --> CORS[CORS Configuration]
  CORS --> CROSS[CrossOrigin]
  CORS --> CCS[CorsConfigurationSource]
  CORS --> UBC[UrlBasedCorsConfigurationSource]
  CORS --> PREFLIGHT[Preflight OPTIONS]
  CORS --> ALLOW[Allowed Origins / Methods]
  CORS --> CRED[Allow Credentials]

  SEC --> CSRF[CSRF Protection]
  CSRF --> COOKIE[CookieCsrfTokenRepository]
  CSRF --> HTTP[HttpSessionCsrfTokenRepository]
  CSRF --> DOUBLE[Double-Submit Cookie]
  CSRF --> DISABLE[Disable for REST APIs]
  CSRF --> SPA[CSRF for SPAs]

  SEC --> HEADERS[Security Headers]
  HEADERS --> CSP[Content Security Policy]
  HEADERS --> HSTS[HSTS]
  HEADERS --> XFO[X-Frame-Options]
  HEADERS --> XSS[X-XSS-Protection]
