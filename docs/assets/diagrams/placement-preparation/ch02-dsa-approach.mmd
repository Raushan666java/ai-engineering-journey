flowchart TD
    Read["Read Problem Statement\nIdentify input/output"] --> Analyze["Analyze Constraints\nN size, time limits,\nmemory limits"]
    Analyze --> Brute["Think Brute Force\nSimplest working solution"]
    Brute --> Optimize{"Can optimize?"}
    Optimize -->|Yes| Pattern["Identify Pattern\nTwo pointers, DP, BFS/DFS\nSliding window, Greedy"]
    Pattern --> DataStructure["Choose Data Structure\nHashMap, Heap, Stack,\nTree, Graph"]
    DataStructure --> Pseudo["Write Pseudo-code\nEdge Cases + Complexity"]
    Optimize -->|No| Pseudo
    Pseudo --> Code["Implement in Java\ncompilable code"]
    Code --> Test["Test with Examples\nDry-run with sample"]
    Test --> Edge["Edge Cases\nEmpty, Single, Large\nNegative values"]
    Edge --> Complexity["Time & Space\nComplexity Analysis"]

    style Read fill:#e3f2fd,stroke:#1565c0,color:#000
    style Pattern fill:#e8f5e9,stroke:#2e7d32,color:#000
    style Code fill:#fff3e0,stroke:#f57c00,color:#000
    style Test fill:#fce4ec,stroke:#c62828,color:#000
