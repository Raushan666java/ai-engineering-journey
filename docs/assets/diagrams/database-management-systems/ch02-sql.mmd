        Update["UPDATE Students<br/>SET gpa = 4.0<br/>WHERE id = 1;"]
        Delete["DELETE FROM Students<br/>WHERE id = 1;"]
    end

    subgraph Joins["SQL Joins"]
        InnerJoin["INNER JOIN<br/>only matching rows"]
