        R1["Minimization: C_alg / C_opt ≤ ρ"]
        R2["Maximization: C_opt / C_alg ≤ ρ"]
        R3["1 = optimal (P problems)"]
    end

    subgraph Schemes["Approximation Schemes"]
        PTAS["PTAS\nPolynomial in n\nExponential in 1/ε"]
        FPTAS["FPTAS\nPolynomial in n AND 1/ε\nKnapsack has FPTAS"]
    end

    style Approx fill:#e3f2fd,stroke:#1565c0,color:#000,stroke-width:2px
