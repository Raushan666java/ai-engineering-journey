flowchart TB
  APP[Logging Error Handling i18n]

  APP --> LOG[Logging]
  LOG --> SLF4J[SLF4J API]
  SLF4J --> FMT[Parameterized Logging]
  SLF4J --> MDC[MDC Diagnostic Context]
  LOG --> LOGBACK[Logback Default]
  LOGBACK --> APPEND[Appenders]
  LOGBACK --> ROLL[Rolling Policies]
  LOGBACK --> ENC[Encoders / Layouts]
  LOG --> LOG4J2[Log4j2 Alternative]
  LOG4J2 --> ASYNC[Async Loggers]
  LOG4J2 --> LAYOUT[Layout Patterns]
  LOG --> JSON[JSON Structured Logging]
  JSON --> ELK[ELK Stack Integration]

  APP --> ERROR[Error Handling]
  ERROR --> CA[ControllerAdvice]
  CA --> EH[ExceptionHandler]
  CA --> RBA[RestControllerAdvice]
  ERROR --> RES[Error Responses]
  RES --> RFC[RFC 7807 Problem Details]
  RES --> CUSTOM[Custom Error DTOs]
  ERROR --> SC[Status Codes]
  ERROR --> EXC[Exception Types]
  EXC --> RE[ResponseStatusException]

  APP --> I18N[Internationalization]
  I18N --> MS[MessageSource]
  MS --> REL[ReloadableResourceBundleMessageSource]
  I18N --> LR[LocaleResolver]
  LR --> AC[AcceptHeaderLocaleResolver]
  LR --> SESSION[SessionLocaleResolver]
  LR --> COOKIE[CookieLocaleResolver]
  I18N --> THYME[Thymeleaf i18n]
  I18N --> VALID[Validation Messages i18n]
