        RightJoin["RIGHT JOIN<br/>all right + matching left"]
        FullJoin["FULL OUTER JOIN<br/>all rows from both sides"]
        CrossJoin["CROSS JOIN<br/>Cartesian product"]
    end

    subgraph Agg["Aggregation & Grouping"]
        Funcs["COUNT, SUM, AVG, MAX, MIN"]
