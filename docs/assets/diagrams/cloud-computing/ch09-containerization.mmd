flowchart TD
    subgraph Docker["Docker Architecture"]
        DF["Dockerfile"] --> Image["Image\nRead-only template\nLayered filesystem"]
        Image --> Registry["Registry\nDocker Hub / ECR / ACR"]
        Registry --> Container["Container\nRunnable instance\nIsolated process"]
        DockerE["Docker Engine\nRuntime / Daemon"]
        Container --> DockerE
    end

    subgraph K8s["Kubernetes Architecture"]
        Master["Control Plane\nAPI Server, Scheduler\nController Manager, etcd"]
        Node1["Worker Node 1\nKubelet\nPod 1 | Pod 2"]
        Node2["Worker Node 2\nKubelet\nPod 3 | Pod 4"]
        NodeN["Worker Node N\nKubelet\nPod N"]

        Master --> Node1
        Master --> Node2
        Master --> NodeN

        Svc["Service\nStable network endpoint"]
        Dep["Deployment\nDeclarative updates\nRolling updates"]
        Namespace["Namespace\nResource isolation"]
    end

    Docker -->|"Container images"| K8s

